      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "pm.globals.set('generateSignature', `() => {",
          "    const signatureKey = pm.variables.get('signature_key');",
          "    const signature = CryptoJS.HmacSHA256(pm.variables.replaceIn(pm.request.body.raw), signatureKey).toString();",
          "    pm.request.headers.add({",
          "        key: \"X-Signature\",",
          "        value: signature",
          "    });   ",
          "}`);",
          "",
          ""
        ]
